# Which video provider backs generation. "mock" needs nothing and works
# out of the box (renders real placeholder clips locally via ffmpeg, so
# you can see the full pipeline work without spending anything).
# Switch to "apimart" once you have a real API key.
VIDEO_PROVIDER=mock

# APIMart (https://apimart.ai) — only needed when VIDEO_PROVIDER=apimart.
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1

# Optional: DeepSeek rewrites your short prompt into a detailed video
# prompt (scene, camera, lighting) before it's sent to the video model.
# Leave empty to skip this step (prompt is used as-is).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Starting balance (in display "credits", 1 credit = $0.01) given to the
# local demo user the first time the app runs.
STARTING_CREDITS=5000
